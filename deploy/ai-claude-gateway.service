[Unit]
Description=AI Agent to Claude gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
ExecStart=/usr/bin/node /usr/local/lib/ai-claude-gateway/gateway.mjs
Environment=AI_CLAUDE_GATEWAY_HOST=127.0.0.1
Environment=AI_CLAUDE_GATEWAY_PORT=8791
Environment=AI_CLAUDE_GATEWAY_EVENT_LOG=/var/log/ai-claude-gateway/events.jsonl
LogsDirectory=ai-claude-gateway
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
